# Do not copy this file by hand. Run `kilnbase init` to generate a .env with real secrets.
# Services refuse to start while any value is still "change-me".
POSTGRES_PASSWORD=change-me
KILNBASE_AUTHENTICATOR_PASSWORD=change-me
KILNBASE_STORAGE_SIGNING_KEY=change-me
KILNBASE_JWT_PRIVATE_JWK=change-me
KILNBASE_JWKS=change-me
KILNBASE_ANON_KEY=change-me
KILNBASE_SERVICE_ROLE_KEY=change-me
KILNBASE_S3_ACCESS_KEY_ID=change-me
KILNBASE_S3_SECRET_ACCESS_KEY=change-me
